{
  "expo": {
    "name": "XTodo",
    "slug": "XTodo",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xtodo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.github.fatalifataliyev.xtodo"
    },
    "android": {
      "backgroundColor": "#000000",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "package": "com.github.fatalifataliyev.xtodo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification_icon.png",
          "sounds": ["./assets/sounds/reminder.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "image": "./assets/images/icon_transparent.png",
            "imageWidth": 180
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-audio",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodoList",
              "label": "XTodo Todo List",
              "minWidth": "320dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "description": "List of todos and more",
              "previewImage": "./assets/images/widget/preview.jpg",
              "widgetFeatures": "reconfigurable",
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "AddTodo",
              "label": "XTodo Add todo",
              "minWidth": "60dp",
              "minHeight": "60dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "description": "Add todo from your home screen",
              "previewImage": "./assets/images/add_neum.png",
              "resizeMode": "none"
            }
          ]
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e74550f2-7141-4645-9944-f729c79c9bcc"
      }
    }
  }
}

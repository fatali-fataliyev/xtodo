{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["jest"],
    "strict": true,
    "paths": {
      "@/assets/*": ["./assets/*"],
      "@/*": ["./src/*"],
    },
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/constants/colors.js",
    "src/components/ui/SaveChangesModal",
  ],
}
